<Project Sdk="Microsoft.NET.Sdk">
  <!-- The mock add-in (REQ-GAP-65, SCN-65): the add-in's own client and loop, with a fake map instead
       of ArcGIS Pro. dotnet build -c Release -p:GwbTfm=net10.0 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(GwbTfm)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(GwbTfm)' != ''">$(GwbTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GwbProSync.Core\GwbProSync.Core.csproj" />
    <None Include="..\contract\sync-contract.json" CopyToOutputDirectory="PreserveNewest" Link="sync-contract.json" />
  </ItemGroup>
</Project>
