{
  "project": "GIS Workbench",
  "pack": "gis-workbench",
  "admins": [
    "brianm-di4u"
  ],
  "trustedBots": [
    "dependabot[bot]"
  ],
  "models": {
    "worker": "sonnet",
    "workerComplex": "opus",
    "workerSimple": "haiku"
  },
  "verify": {
    "fast": [
      "node build/check-policy.mjs",
      "npx vitest run"
    ],
    "full": [
      "node build/verify-scope.mjs"
    ],
    "e2e": [
      "npm run test:e2e"
    ],
    "checkNames": [
      "verify"
    ]
  },
  "tiers": {
    "t0Paths": [
      "docs/**/*.md",
      "README.md"
    ],
    "t0Exclude": [
      "docs/decisions/**",
      "docs/PRD.md",
      "docs/THREAT-MODEL.md",
      "docs/formats.md",
      "docs/RUNBOOK.md",
      "docs/ROLLBACK.md",
      "docs/VERIFICATION.md"
    ],
    "t2Paths": [
      ".github/**",
      ".pipeline/**",
      "pipeline.config.json",
      "pipeline.lock.json",
      ".claude/settings*.json",
      ".claude/hooks/**",
      ".claude/agents/**",
      ".claude/workflows/**",
      ".claude/skills/council/**",
      ".claude/skills/reviewer-eval/**",
      "REVIEW.md",
      "**/CLAUDE.md",
      "**/AGENTS.md",
      "docs/POLICY.md",
      "docs/PRD.md",
      "LICENSE*",
      "THIRD_PARTY*",
      "TRADEMARKS.md",
      "SECURITY.md",
      "build/check-policy*",
      "crates/deny.toml",
      "build/origins.json",
      "build/airgap.mjs",
      "sidecar/installer/licences.json",
      "build/packs-sources.json",
      "build/csm/NOTICES.txt",
      "sidecar/installer/**/*NOTICE*",
      "crates/vendor/**/LICENSE*",
      "crates/vendor/**/COPYING*",
      "crates/vendor/**/NOTICE*",
      ".claude/skills/release/**",
      ".claude/skills/decision/**",
      "docs/decisions/**",
      "sidecar/**",
      "**/build.rs",
      ".cargo/**",
      "crates/.cargo/**",
      "crates/vendor/**",
      "build/release/**"
    ],
    "decisionPaths": [
      "docs/decisions/**"
    ],
    "sizeWarnLines": 800
  },
  "merge": {
    "t0": "auto",
    "t1": "auto",
    "t2": "human"
  },
  "privateAutoMerge": false,
  "council": {
    "maxNits": 5,
    "maxSeats": 5,
    "maxDiffGrowth": 1.5,
    "loopModel": "sonnet",
    "closeModel": "opus",
    "maxLoopRounds": 8,
    "maxCloseRounds": 4,
    "externalSeats": [],
    "triggers": {
      "ui": [
        "**/*.html",
        "**/*.css",
        "app/src/shell/**",
        "app/src/shell2/**",
        "app/src/mobile/**",
        "app/src/styles/**"
      ],
      "content": [
        "**/package.json",
        "**/package-lock.json",
        "**/Cargo.toml",
        "**/Cargo.lock",
        "THIRD_PARTY*",
        "LICENSE*",
        "TRADEMARKS.md",
        "build/packs-sources.json",
        "build/natural-earth/**"
      ]
    },
    "extraSeats": [
      {
        "agent": "council-geo-correctness",
        "paths": [
          "crates/**",
          "app/src/geo/**",
          "app/src/formats/**",
          "app/src/sensor/**",
          "app/src/tiles/**",
          "app/src/vector/**",
          "app/src/products/**",
          "app/src/analysis/**"
        ]
      }
    ]
  },
  "freshness": {
    "mode": "overlap",
    "floor": [
      "build/**",
      "playwright*.config.js",
      "vitest.config.js",
      ".node-version",
      "crates/rust-toolchain.toml",
      "sidecar/rust-toolchain.toml",
      "crates/deny.toml",
      "sidecar/deny.toml",
      ".cargo/**",
      "crates/.cargo/**",
      "**/build.rs",
      "crates/vendor/**",
      "REVIEW.md",
      "CLAUDE.md",
      "AGENTS.md",
      ".claude/agents/**",
      ".claude/workflows/**",
      ".claude/skills/**"
    ],
    "groups": {
      "i18n-and-commands": [
        "app/src/i18n/**",
        "app/src/shell/command-meta.js",
        "app/src/shell/ribbon-data.js",
        "app/src/shell/commands.js"
      ],
      "test-support": [
        "tests/quarantine.json",
        "tests/e2e/helpers.js"
      ],
      "crate-bundles": [
        "crates/bundles/**"
      ],
      "sidecar": [
        "sidecar/**"
      ],
      "sidecar-client": [
        "app/src/sidecar/**",
        "sidecar/gwb-sidecar-api/**"
      ],
      "crate-gw-abi": [
        "crates/gw-abi/**"
      ],
      "crate-gw-adjust": [
        "crates/gw-adjust/**"
      ],
      "crate-gw-aero": [
        "crates/gw-aero/**"
      ],
      "crate-gw-aviation": [
        "crates/gw-aviation/**"
      ],
      "crate-gw-codec": [
        "crates/gw-codec/**"
      ],
      "crate-gw-extract": [
        "crates/gw-extract/**"
      ],
      "crate-gw-fuzz": [
        "crates/gw-fuzz/**"
      ],
      "crate-gw-geodesy": [
        "crates/gw-geodesy/**"
      ],
      "crate-gw-geoproc": [
        "crates/gw-geoproc/**"
      ],
      "crate-gw-match": [
        "crates/gw-match/**"
      ],
      "crate-gw-parse": [
        "crates/gw-parse/**"
      ],
      "crate-gw-pointcloud": [
        "crates/gw-pointcloud/**"
      ],
      "crate-gw-raster": [
        "crates/gw-raster/**"
      ],
      "crate-gw-sar": [
        "crates/gw-sar/**"
      ],
      "crate-gw-sensor": [
        "crates/gw-sensor/**"
      ],
      "crate-gw-spectral": [
        "crates/gw-spectral/**"
      ],
      "crate-gw-terrain": [
        "crates/gw-terrain/**"
      ],
      "crate-gw-tiles": [
        "crates/gw-tiles/**"
      ],
      "crate-gw-tin": [
        "crates/gw-tin/**"
      ],
      "crate-gw-vector": [
        "crates/gw-vector/**"
      ]
    }
  },
  "breaker": {
    "window": 20,
    "maxFailures": 3
  },
  "autopilot": {
    "maxPrsPerDay": 5,
    "maxConsecutiveFailures": 2
  },
  "formatters": {},
  "licenseExceptions": [
    "h5wasm",
    "resource-tracker",
    "squint-cljs"
  ],
  "smoke": {
    "url": "https://www.gisworkbench.com/app/gis-workbench",
    "contains": "GIS Workbench"
  }
}
