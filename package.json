{
  "name": "gis-workbench",
  "version": "2.0.0",
  "private": true,
  "description": "GIS Workbench: single-file, offline, browser-based imagery exploitation and photogrammetry tool",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "build:dev": "node build/build.mjs --dev",
    "build:js": "node build/build.mjs --skip-rust",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path crates/Cargo.toml --workspace",
    "test:e2e": "playwright test",
    "trace": "node build/traceability.mjs",
    "ci:fast": "npm run test:rust && npm test && npm run build",
    "ci:full": "npm run ci:fast && npm run test:e2e && npm run trace"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "ag-psd": "31.0.3",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "flatgeobuf": "4.4.0",
    "geotiff": "3.0.5",
    "hyparquet-writer": "0.17.0",
    "kdbush": "4.0.2",
    "milsymbol": "3.0.4",
    "mpegts.js": "1.8.2",
    "pmtiles": "4.5.0",
    "polygon-clipping": "0.15.7",
    "pptxgenjs": "4.0.1",
    "proj4": "2.22.0",
    "rbush": "4.0.1",
    "rtree-sql.js": "1.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "egm96-universal": "1.1.1",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "geographiclib-geodesic": "2.2.0",
    "h5wasm": "0.10.3",
    "mgrs": "2.2.0",
    "onnxruntime-web": "1.30.0",
    "proj-wasm": "0.1.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
